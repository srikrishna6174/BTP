// ==============================================================================
// EAP-IMP: Improved Registration Phase Protocol (Scyther SPDL Specification)
// ------------------------------------------------------------------------------
// Models the secure registration phase over public channels using public-key
// encryption and challenge-response key derivation between:
//   - Device (D)
//   - Authentication Server (AS)
// ==============================================================================

// Global cryptographic primitives and types
hashfunction h;             // Cryptographic one-way hash function
const XOR: Function;        // Abstract bitwise exclusive-OR (XOR) function
const plus: Function;       // Abstract concatenation / combining operator
usertype TimeStamp;         // Abstract type for message timestamps
usertype Key;               // Abstract type for cryptographic keys

// Protocol definition specifying the two participating roles during registration
protocol EAP-IMP(D, AS)
{
    // ==========================================================================
    // Role: Device (D) - IoT device registering with Authentication Server
    // ==========================================================================
    role D
    {
        // Long-term constants, credentials, and parameters
        // IDd: Device ID, IDas: Server ID, IDap: AP ID, pswd: stored password,
        // LIAd: Lease Interval, ET: Expiry Time, Mid: Masked ID, MSID: Masked Server ID,
        // TID: Temporary ID, ETFR: Expiry Time for Fast Reconnect, MKS: Master Key Seed,
        // W: PUF helper data, Plist: Parameter List, OTenc: Encrypted One-Time Nonces
        const IDd, IDas, IDap, pswd, LIAd, ET, Mid, MSID, TID, ETFR, MKS, W, Plist, OTenc;

        // Fresh timestamps and random challenge nonce generated by Device
        fresh T1, T4: TimeStamp;    // Fresh timestamps generated by Device for message freshness
        fresh Na: Nonce;            // Fresh 128-bit challenge nonce generated by Device

        // Variables to bind parameters received from Server in registration response
        var Nb, r1: Nonce;          // Server challenge nonce Nb and blinding nonce r1
        var T2, T3: TimeStamp;      // Server timestamps received in reply

        // Macro definition for device pseudo-identity
        macro Ii = h(plus(pswd, IDd)); // Pseudo-identity derived from password and device ID

        // Step 1: Device sends registration request to Authentication Server (AS)
        send_1(D, AS,
            {plus(Ii, Na, T1, ET, LIAd, TID, W, Plist)} pk(AS), // Asymmetric encryption with Server's public key pk(AS)
            h(plus(Ii, Na, T1, ET, LIAd, TID, W, Plist))        // Integrity verification hash / message authentication tag
        );

        // Step 2: Device receives registration response from Authentication Server (AS)
        recv_2(AS, D,
            {plus({plus(Ii, r1)} MKS, {plus(IDas, r1)} MKS, Nb, T3, OTenc)} (XOR(Na, Ii)), // Decrypted using symmetric key (Na XOR Ii)
            h(plus({plus(Ii, r1)} MKS, {plus(IDas, r1)} MKS, Nb, T3, OTenc))               // Integrity verification hash tag
        );

        // Session registration key derivation shared between Device and Server
        macro Kreg = h(XOR(XOR(Na, Nb), Ii)); // Derived registration symmetric key: Kreg = h((Na XOR Nb) XOR Ii)

        // Security Claims evaluated for Device (D)
        claim_D1(D, Secret, Na);    // Claim D1: Nonce Na remains confidential and secret
        claim_D2(D, Secret, Nb);    // Claim D2: Nonce Nb remains confidential and secret
        claim_D3(D, Secret, Ii);    // Claim D3: Device pseudo-identity Ii remains secret
        claim_D31(D, Secret, Kreg); // Claim D31: Derived registration key Kreg remains secret
        claim_D4(D, Weakagree);     // Claim D4: Weak agreement between Device and Server
        claim_D5(D, Alive);         // Claim D5: Server aliveness verification
        claim_D6(D, Niagree);       // Claim D6: Non-injective agreement on session parameters
        claim_D7(D, Nisynch);       // Claim D7: Non-injective synchronization (replay-attack resistance)
    }

    // ==========================================================================
    // Role: Authentication Server (AS) - Registers and initializes device credentials
    // ==========================================================================
    role AS
    {
        // Long-term constants, credentials, and parameters known to Server
        const IDd, IDas, IDap, pswd, LIAd, ET, Mid, MSID, TID, ETFR, MKS, W, Plist, OTenc;

        // Variables to bind received parameters from Device registration request
        var T1, T4: TimeStamp;      // Timestamps received from Device
        var Na: Nonce;              // Challenge nonce received from Device

        // Fresh values locally generated by Server
        fresh Nb, r1: Nonce;        // Fresh server challenge nonce Nb and blinding factor r1
        fresh T2, T3: TimeStamp;    // Fresh timestamps generated by Server

        // Macro definition for device pseudo-identity
        macro Ii = h(plus(pswd, IDd)); // Pseudo-identity derived from password and device ID

        // Step 1: Server receives registration request from Device
        recv_1(D, AS,
            {plus(Ii, Na, T1, ET, LIAd, TID, W, Plist)} pk(AS), // Decrypted using Server's private key
            h(plus(Ii, Na, T1, ET, LIAd, TID, W, Plist))        // Integrity verification hash check
        );

        // Step 2: Server sends registration response message to Device
        send_2(AS, D,
            {plus({plus(Ii, r1)} MKS, {plus(IDas, r1)} MKS, Nb, T3, OTenc)} (XOR(Na, Ii)), // Encrypted using symmetric key (Na XOR Ii)
            h(plus({plus(Ii, r1)} MKS, {plus(IDas, r1)} MKS, Nb, T3, OTenc))               // Integrity verification hash tag
        );

        // Session registration key derivation shared between Device and Server
        macro Kreg = h(XOR(XOR(Na, Nb), Ii)); // Derived registration symmetric key: Kreg = h((Na XOR Nb) XOR Ii)

        // Security Claims evaluated for Authentication Server (AS)
        claim_AS1(AS, Secret, Na);    // Claim AS1: Nonce Na remains confidential and secret
        claim_AS2(AS, Secret, Nb);    // Claim AS2: Nonce Nb remains confidential and secret
        claim_AS3(AS, Secret, Ii);    // Claim AS3: Device pseudo-identity Ii remains secret
        claim_AS31(AS, Secret, Kreg); // Claim AS31: Derived registration key Kreg remains secret
        claim_AS4(AS, Weakagree);     // Claim AS4: Weak agreement between Server and Device
        claim_AS5(AS, Alive);         // Claim AS5: Device aliveness verification
        claim_AS6(AS, Niagree);       // Claim AS6: Non-injective agreement on session parameters
        claim_AS7(AS, Nisynch);       // Claim AS7: Non-injective synchronization (replay-attack resistance)
    }
}
