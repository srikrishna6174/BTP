// ==============================================================================
// EAP-IMP: Improved Authentication Protocol (Scyther SPDL Specification)
// ------------------------------------------------------------------------------
// Models the three-party mutual authentication, session key exchange, and
// dynamic identity updating among:
//   - Device (D)
//   - Access Point (AP)
//   - Authentication Server (AS)
// ==============================================================================

// Global cryptographic primitives and types
hashfunction h;             // Cryptographic one-way hash function
const XOR: Function;        // Abstract bitwise exclusive-OR (XOR) function
const plus: Function;       // Abstract concatenation / combining operator
const PUF: Function;        // Physical Unclonable Function response model
usertype TimeStamp;         // Abstract type for message timestamps
usertype Key;               // Abstract type for cryptographic keys

// Protocol definition specifying the three participating roles
protocol EAP-IMP(D, AP, AS)
{
    // ==========================================================================
    // Role: Device (D) - IoT device requesting authentication
    // ==========================================================================
    role D
    {
        // Long-term constants and identifiers known to Device:
        // IDd: Device ID, IDas: Server ID, IDap: AP ID, pswd: stored password,
        // LIAd: Lease Interval, ET: Expiry Time, MId: Masked ID, MSID: Masked Server ID,
        // OTindex: One-Time Nonce Index, k: Shared Key (Kreg), MKS: Master Key Seed, TSK: Temporary Secret Key
        const IDd, IDas, IDap, pswd, LIAd, ET, MId, MSID, OTindex, k, MKS, TSK: Function;

        // Fresh values locally generated by Device
        fresh T1: TimeStamp;        // Fresh timestamp generated by Device for message freshness
        fresh Nc: Nonce;            // Fresh 128-bit challenge nonce generated by Device
        fresh R1: Nonce;            // Fresh random blinding nonce generated by Device

        // Cryptographic macros for Device Authentication Request
        macro Ii = h(plus(pswd, IDd));       // Device pseudo-identity derived from password and ID
        macro Iu = h(XOR(Ii, R1));           // Dynamic temporary identity mask for current session

        // Step 1: Device sends authentication request message to Access Point
        send_1(D, AP,
            {plus(Iu, MSID, Nc, T1, R1, LIAd, OTindex)}k, // Encrypted credentials payload using shared key k
            h(Iu, MSID, Nc, T1, R1, LIAd, OTindex)        // Hash integrity tag / message authentication code
        );

        // Variables to bind parameters received from Server via AP
        var T3: TimeStamp;          // Server timestamp received in reply
        var Nd: Nonce;              // Server challenge nonce received in reply
        var R2: Nonce;              // Server random blinding nonce received in reply

        // Macros for updating parameters and deriving the Session Key (SK)
        macro MIDNew = {plus(MId, R2)}MKS;               // Updated masked device identity for future sessions
        macro IuN = h(XOR(Ii, R2, R1));                  // New temporary identity mask incorporating R1 and R2
        macro MSIDNew = XOR(MSID, R2);                   // Updated masked server identity
        macro Knew = h(XOR(k, Nc));                      // Updated shared symmetric key derived from k and Nc
        macro SK = XOR(XOR(Knew, Nd), IuN);              // Established session key: SK = Knew XOR Nd XOR IuN

        // Step 4: Device receives final authentication response forwarded by AP
        recv_4(AP, D,
            {plus(IuN, MIDNew, MSIDNew, Nd, T3, R2, TSK)}Knew, // Encrypted response decrypted using Knew
            h(plus(IuN, MIDNew, MSIDNew, Nd, T3, TSK, R2))     // Integrity verification tag
        );

        // Security Claims evaluated for Device (D)
        claim_D1(D, Secret, Nc);    // Claim D1: Nonce Nc remains confidential and secret
        claim_D2(D, Secret, Nd);    // Claim D2: Nonce Nd remains confidential and secret
        claim_D3(D, Secret, R1);    // Claim D3: Blinding nonce R1 remains confidential and secret
        claim_D4(D, Secret, SK);    // Claim D4: Established session key SK is secret
        claim_D9(D, Secret, Knew);  // Claim D9: Updated symmetric key Knew is secret
        claim_D5(D, Weakagree);     // Claim D5: Weak agreement with participating roles
        claim_D6(D, Alive);         // Claim D6: Aliveness verification of communication partners
        claim_D7(D, Niagree);       // Claim D7: Non-injective agreement on protocol data
        claim_D8(D, Nisynch);       // Claim D8: Non-injective synchronization (replay-attack protection)
    }

    // ==========================================================================
    // Role: Access Point (AP) - Pass-through network authenticator
    // ==========================================================================
    role AP
    {
        // Long-term constants and identifiers known to Access Point:
        // IDd: Device ID, IDas: Server ID, IDap: AP ID, pswd: password,
        // LIAd: Lease Interval, ET: Expiry Time, MId: Masked ID, MSID: Masked Server ID,
        // OTindex: One-Time Nonce Index, k: Shared Key, MKS: Master Key Seed, TSK: Temporary Secret Key
        const IDd, IDas, IDap, pswd, LIAd, ET, MId, MSID, OTindex, k, MKS, TSK: Function;

        // Variables to bind received timestamps and nonces
        var T1: TimeStamp;          // Timestamp received from Device
        var T3: TimeStamp;          // Timestamp received from Server
        var Nc: Nonce;              // Challenge nonce received from Device
        var R1: Nonce;              // Blinding nonce received from Device
        var Nd: Nonce;              // Challenge nonce received from Server
        var R2: Nonce;              // Blinding nonce received from Server

        // Protocol macros for validation and key derivation
        macro Ii = h(plus(pswd, IDd));                   // Device pseudo-identity
        macro Iu = h(XOR(Ii, R1));                       // Temporary identity mask
        macro MIDNew = {plus(MId, R2)}MKS;               // Updated masked device identity
        macro IuN = h(XOR(Ii, R2, R1));                  // New temporary identity mask
        macro MSIDNew = XOR(MSID, R2);                   // Updated masked server identity
        macro Knew = h(XOR(k, Nc));                      // Updated shared key
        macro SK = XOR(XOR(Knew, Nd), IuN);              // Derived session key

        // Step 1: AP receives authentication request from Device
        recv_1(D, AP,
            {plus(Iu, MSID, Nc, T1, R1, LIAd, OTindex)}k, // Encrypted credentials payload
            h(Iu, MSID, Nc, T1, R1, LIAd, OTindex)        // Hash integrity tag
        );

        // Step 2: AP forwards authentication request message to Server
        send_2(AP, AS,
            {plus(Iu, MSID, Nc, T1, R1, LIAd, OTindex)}k, // Forwarded encrypted credentials
            h(Iu, MSID, Nc, T1, R1, LIAd, OTindex)        // Forwarded integrity tag
        );

        // Step 3: AP receives authentication response from Server
        recv_3(AS, AP,
            {plus(IuN, MIDNew, MSIDNew, Nd, T3, R2, TSK)}Knew, // Encrypted response payload
            h(plus(IuN, MIDNew, MSIDNew, Nd, T3, TSK, R2))     // Integrity verification tag
        );

        // Step 4: AP forwards authentication response to Device
        send_4(AP, D,
            {plus(IuN, MIDNew, MSIDNew, Nd, T3, R2, TSK)}Knew, // Forwarded response payload
            h(plus(IuN, MIDNew, MSIDNew, Nd, T3, TSK, R2))     // Forwarded integrity tag
        );

        // Security Claims evaluated for Access Point (AP)
        claim_AP1(AP, Secret, Nc);   // Claim AP1: Nonce Nc confidentiality
        claim_AP2(AP, Secret, Nd);   // Claim AP2: Nonce Nd confidentiality
        claim_AP3(AP, Secret, R2);   // Claim AP3: Nonce R2 confidentiality
        claim_AP4(AP, Secret, SK);   // Claim AP4: Session key SK secrecy
        claim_AP5(AP, Weakagree);    // Claim AP5: Weak agreement with participating roles
        claim_AP6(AP, Alive);        // Claim AP6: Aliveness verification of partners
        claim_AP7(AP, Niagree);      // Claim AP7: Non-injective agreement
        claim_AP8(AP, Nisynch);      // Claim AP8: Non-injective synchronization
    }

    // ==========================================================================
    // Role: Authentication Server (AS) - Core authentication authority
    // ==========================================================================
    role AS
    {
        // Long-term constants and identifiers known to Server:
        // IDd: Device ID, IDas: Server ID, IDap: AP ID, pswd: stored password,
        // LIAd: Lease Interval, ET: Expiry Time, MId: Masked ID, MSID: Masked Server ID,
        // OTindex: One-Time Nonce Index, k: Shared Key (Kreg), MKS: Master Key Seed, TSK: Temporary Secret Key
        const IDd, IDas, IDap, pswd, LIAd, ET, MId, MSID, OTindex, k, MKS, TSK: Function;

        // Variables to bind received parameters from Device via AP
        var T1: TimeStamp;          // Timestamp received from Device
        var Nc: Nonce;              // Challenge nonce received from Device
        var R1: Nonce;              // Blinding nonce received from Device

        // Macros for verifying received Device credentials
        macro Ii = h(plus(pswd, IDd));       // Derived device pseudo-identity
        macro Iu = h(XOR(Ii, R1));           // Derived temporary identity mask

        // Step 2: Server receives authentication request forwarded by AP
        recv_2(AP, AS,
            {plus(Iu, MSID, Nc, T1, R1, LIAd, OTindex)}k, // Decrypted using shared symmetric key k
            h(Iu, MSID, Nc, T1, R1, LIAd, OTindex)        // Verified for message integrity
        );

        // Fresh values locally generated by Server
        fresh T3: TimeStamp;        // Fresh timestamp generated by Server for response freshness
        fresh Nd: Nonce;            // Fresh 128-bit challenge nonce generated by Server
        fresh R2: Nonce;            // Fresh random blinding nonce generated by Server

        // Macros for identity update and session key computation
        macro MIDNew = {plus(MId, R2)}MKS;               // Updated masked device identity
        macro IuN = h(XOR(Ii, R2, R1));                  // New temporary identity mask
        macro MSIDNew = XOR(MSID, R2);                   // Updated masked server identity
        macro Knew = h(XOR(k, Nc));                      // Updated shared symmetric key
        macro SK = XOR(XOR(Knew, Nd), IuN);              // Established session key: SK = Knew XOR Nd XOR IuN

        // Step 3: Server sends response message to Access Point
        send_3(AS, AP,
            {plus(IuN, MIDNew, MSIDNew, Nd, T3, R2, TSK)}Knew, // Encrypted using updated key Knew
            h(plus(IuN, MIDNew, MSIDNew, Nd, T3, TSK, R2))     // Integrity verification tag
        );

        // Security Claims evaluated for Authentication Server (AS)
        claim_AS1(AS, Secret, Nc);   // Claim AS1: Nonce Nc confidentiality
        claim_AS2(AS, Secret, Nd);   // Claim AS2: Nonce Nd confidentiality
        claim_AS3(AS, Secret, R2);   // Claim AS3: Nonce R2 confidentiality
        claim_AS41(AS, Secret, Knew);// Claim AS41: Updated symmetric key Knew secrecy
        claim_AS4(AS, Secret, SK);   // Claim AS4: Session key SK secrecy
        claim_AS5(AS, Weakagree);    // Claim AS5: Weak agreement with participating roles
        claim_AS6(AS, Alive);        // Claim AS6: Aliveness verification of partners
        claim_AS7(AS, Niagree);      // Claim AS7: Non-injective agreement
        claim_AS8(AS, Nisynch);      // Claim AS8: Non-injective synchronization
    }
}